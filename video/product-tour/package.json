{
  "name": "product-tour",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --yes hyperframes@0.7.77 preview",
    "check": "npx --yes hyperframes@0.7.77 check",
    "render": "npx --yes hyperframes@0.7.77 render",
    "publish": "npx --yes hyperframes@0.7.77 publish",
    "snapshot": "npx --yes hyperframes@0.7.77 snapshot",
    "build": "python3 build.py",
    "audio:generate": "python3 prepare-audio.py",
    "audio:mix": "remotion render remotion/index.jsx TourAudio renders/mix.wav --codec=wav --concurrency=2",
    "test": "node --test media.test.mjs"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.542",
    "remotion": "4.0.542",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
