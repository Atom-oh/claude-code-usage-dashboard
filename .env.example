# Server (dashboard/server) — see dashboard/CLAUDE.md and docs/api-reference.md

# HTTP port the server listens on
PORT=8080

# ClickHouse connection; this URL is an example for a local port-forward
CH_URL=http://localhost:18123
CH_DB=claude_code
CH_USER=
CH_PASSWORD=
# CH_HOST/CH_PORT are an alternative to CH_URL — leave unset if CH_URL is set
# CH_HOST=localhost
# CH_PORT=18123

# Basic Auth for the whole dashboard; missing credentials require the explicit local bypass below
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Run without Basic Auth — set to 1 for local `npm run dev`; leaving BASIC_AUTH_* empty AND this empty
# makes the server exit 1 at boot. Never 1 on an internet-facing deployment.
AUTH_ALLOW_INSECURE=

# "Ask Claude" chat assistant (Bedrock)
CHAT_MODEL_ID=global.anthropic.claude-sonnet-5
AWS_REGION=us-east-1
# Overrides AWS_REGION for the Bedrock call only (e.g. workshop accounts limited to us-west-2)
# BEDROCK_REGION=us-west-2
# Allow POST /api/chat without auth; independent of AUTH_ALLOW_INSECURE. Never 1 on an internet-facing
# deployment — it opens LLM-generated SELECTs (readonly, but PII + Bedrock spend) to anyone who can reach the port.
CHAT_ALLOW_INSECURE=

# PII masking — server default is OFF when unset (README env table). This template turns it on because
# a copied .env is usually a real deployment. Only "1"/"true" (case-insensitive) enables it. Masking
# only hides emails on screen — anyone holding the Basic Auth credential can still curl the raw API
# (ADR-006); it is not a data-exfiltration control.
PII_MASK_ENABLED=true

# Minutes before the newest otel_metrics_sum row is considered stale (GET /api/health/data). Must be below 10080 — the probe only looks back 7 days.
DATA_STALE_MINUTES=360

# Optional outbound alert webhook (Slack-compatible {"text": ...} POST). Unset = alerting off.
# Fires when /api/health/data has been non-ok for two consecutive 60s ticks, repeats every
# ALERT_REPEAT_MINUTES while non-ok, and once more on recovery. docs/runbooks/alerting.md
# ALERT_WEBHOOK_URL=
# ALERT_REPEAT_MINUTES=60

# Optional inline JSON object of diagnostic model-price overrides; not a file path
# PRICING_JSON=

# Which cacheWrite price tier to assume for cache-creation tokens: "1h" (default) or "5m". Any other
# value makes the server exit at startup (pricing.js).
PRICING_CACHE_WRITE_TTL=1h

# ab compares the bedrock/enterprise pair; single tells the SPA this org has one channel
GROUP_MODE=ab
# Default range (days) when a request omits `from`; also the warm-cache window
DEFAULT_RANGE_DAYS=2
# Longest range (days) a request may ask for; a longer span is a 400
RANGE_CAP_DAYS=90

# Claude Code harness notifications (optional, .claude/hooks/notify.sh)
# CLAUDE_NOTIFY_WEBHOOK=

# Compose supplies its own ClickHouse credentials/URL and local-auth settings.
# This template is for explicit environment loading when running the server from source.
