# Server (dashboard/server) — see dashboard/CLAUDE.md and docs/api-reference.md

# HTTP port the server listens on
PORT=8080

# ClickHouse connection (required)
CH_URL=http://localhost:18123
CH_DB=claude_code
CH_USER=
CH_PASSWORD=
# CH_HOST/CH_PORT are an alternative to CH_URL — leave unset if CH_URL is set
# CH_HOST=localhost
# CH_PORT=18123

# Basic Auth for the whole dashboard — leave both unset to disable auth (local dev)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Run without Basic Auth; the server otherwise exits 1 at boot — local dev / cluster-internal
# probes only
AUTH_ALLOW_INSECURE=

# "Ask Claude" chat assistant (Bedrock)
CHAT_MODEL_ID=global.anthropic.claude-sonnet-5
AWS_REGION=us-east-1
# Overrides AWS_REGION for the Bedrock call only (e.g. workshop accounts limited to us-west-2)
# BEDROCK_REGION=us-west-2
# Allow POST /api/chat without auth; independent of AUTH_ALLOW_INSECURE
CHAT_ALLOW_INSECURE=

# PII masking — any value other than "1"/"true" (case-insensitive) means masking is OFF
PII_MASK_ENABLED=true

# Minutes before the newest otel_metrics_sum row is considered stale (GET /api/health/data)
DATA_STALE_MINUTES=360

# Optional override for model pricing (JSON file path); unset uses the built-in table
# PRICING_JSON=

# How long a cacheWrite price stays valid before pricing.js re-derives it (ms)
PRICING_CACHE_WRITE_TTL=86400000

# ab compares the bedrock/enterprise pair; single tells the SPA this org has one channel
GROUP_MODE=ab
# Default range (days) when a request omits `from`; also the warm-cache window
DEFAULT_RANGE_DAYS=2
# Longest range (days) a request may ask for; a longer span is a 400
RANGE_CAP_DAYS=90

# Claude Code harness notifications (optional, .claude/hooks/notify.sh)
# CLAUDE_NOTIFY_WEBHOOK=

# dashboard/docker-compose.yml의 로컬 스택은 위 값들 중 CH_URL(http://clickhouse:8123),
# CH_DB, CH_USER, CH_PASSWORD, AUTH_ALLOW_INSECURE=1, PII_MASK_ENABLED=false를 직접 넣는다 —
# 이 파일은 로컬에서 server를 직접 띄울 때(npm run dev)의 템플릿이다.
