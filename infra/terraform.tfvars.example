# cp terraform.tfvars.example terraform.tfvars 후 값을 채운다.
# *.tfvars는 gitignore되지만 이 .example 파일은 그 패턴에 걸리지 않는다(파일명이 .example로 끝난다).
# 비밀값(dashboard_basic_auth_password, clickhouse_*_password)은 여기 적지 않는다 —
# -var 주입이나 별도 gitignore된 secrets.auto.tfvars로 넘긴다.

# 이 스택을 올릴 EKS 클러스터
eks_cluster_name = "YOUR-EKS-CLUSTER"

# Customer environments can use explicit existing infrastructure instead of eksctl naming
# and subnet discovery tags. Verify node-role cluster admission/Karpenter permissions and
# subnet routes/reachability; selecting these inputs does not establish those prerequisites.
# node_role_name    = "YOUR-EXISTING-NODE-ROLE"
# private_subnet_ids = ["subnet-00000000000000001", "subnet-00000000000000002"]

# Route53 호스팅 존과 그 안의 호스트명
domain             = "example.com"
dashboard_hostname = "dashboard.example.com"
ch_ingest_hostname = "ingest.example.com"

# ECR에 실제로 push된 태그. ECR이 IMMUTABLE이라 `latest`는 존재하지 않는다 —
# 이미지를 먼저 push하고 그 타임스탬프 태그를 여기 넣는다(docs/runbooks/deploy-production.md).
dashboard_image_tag = "REPLACE-WITH-A-PUSHED-TIMESTAMP-TAG"

# Dedicated commercial installation: create this Secret in the namespace through the
# customer's secret manager with OIDC_CLIENT_SECRET and random SESSION_SECRET keys.
# No secret values belong in this file. Existing Basic installations keep auth_mode=basic.
# auth_mode        = "oidc"
# oidc_issuer      = "https://YOUR-IDP-ISSUER"
# oidc_client_id   = "YOUR-OIDC-CLIENT-ID"
# oidc_secret_name = "dashboard-oidc-auth"
# oidc_groups_claim = "groups" # Cognito: "cognito:groups"
# session_refresh_max_age_seconds = 2592000 # Optional 30-day login; see organization-sso.md
# oidc_role_groups = {
#   viewer  = ["YOUR-VIEWER-GROUP"]
#   analyst = ["YOUR-ANALYST-GROUP"]
#   admin   = ["YOUR-ADMIN-GROUP"]
# }

# 조직 단위 대시보드 동작(선택) — 기본값은 서버 기본값과 같다. docs/deploying-for-your-org.md §9.
# group_mode         = "ab"   # "ab" | "single"
# default_range_days = 2
# range_cap_days     = 90     # default_range_days 이상
# pii_mask_enabled   = true   # 워크샵 계정은 false

# 알림(선택). docs/runbooks/alerting.md
# alert_email          = "ops@example.com"   # CloudFront 5xx → SNS 이메일(구독 확인 메일 필요)
# alert_repeat_minutes = 60
# alert_webhook_url은 토큰이 든 secret — 이 파일이 아니라 secrets.auto.tfvars(비추적) 또는 -var로 넘긴다.
